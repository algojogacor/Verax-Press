      "docs/editorial/operations/VERAX_EDITORIAL_REVIEW_CHECKLIST.md"
    ],
    "optionalOnDemand": [
      "docs/editorial/examples/good-and-bad-examples.md",
      "docs/editorial/examples/desk-format-examples.md"
    ],
    "failClosedOnInactiveOrUnknownDesk": true,
    "mustNotCrossLoadUnassignedDesksOrFormats": true
  },
  "conflictResolutionHierarchy": [
    {
      "priority": 1,
      "layer": "Universal Integrity, Ethics, and Non-Fabrication",
      "source": "docs/editorial/core/* + FAIL-01..FAIL-07"
    },
    {
      "priority": 2,
      "layer": "Assigned Desk Evidentiary and Legal Rules",
      "source": "docs/editorial/desks/<slug>.md"
    },
    {
      "priority": 3,
      "layer": "Assigned Format Voice, Structure, and Origin Rules",
      "source": "docs/editorial/formats/<format_lowercase>.md"
    },
    {
      "priority": 4,
      "layer": "Specific Assignment Context (Layer D)",
      "source": "docs/editorial/operations/VERAX_AI_AGENT_WORKFLOW.md"
    }
  ],
