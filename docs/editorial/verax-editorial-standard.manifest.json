  "institutionalStatusNote": "Verax Press adalah nama kerja media digital independen percontohan dan belum berbadan hukum pers, belum terverifikasi Dewan Pers, serta belum terdaftar sebagai PSE. Rujukan regulasi eksternal berstatus LEGAL REVIEW REQUIRED.",
  "loadingProtocol": {
    "mode": "selective_by_desk_and_format",
    "alwaysLoad": [
      "docs/editorial/README.md",
      "docs/editorial/core/VERAX_EDITORIAL_IDENTITY.md",
      "docs/editorial/core/VERAX_JOURNALISTIC_PRINCIPLES.md",
      "docs/editorial/core/VERAX_RESEARCH_AND_VERIFICATION.md",
      "docs/editorial/core/VERAX_ETHICS_AND_RESPONSIBILITY.md",
      "docs/editorial/core/VERAX_LANGUAGE_AND_STYLE.md"
    ],
    "loadSingleAssignedDeskFrom": "desks[].profileDocument",
    "loadSingleAssignedFormatFrom": "formats[].profileDocument",
    "loadForAiAgentDrafting": [
      "docs/editorial/operations/VERAX_AI_AGENT_WORKFLOW.md",
      "docs/editorial/operations/VERAX_EDITORIAL_REVIEW_CHECKLIST.md",
      "docs/editorial/VERAX_EDITORIAL_API_INTEGRATION.md"
