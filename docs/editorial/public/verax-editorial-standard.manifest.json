  "institutionalStatusNote": "Verax Press beroperasi sebagai nama kerja media digital independen percontohan. Standar VERAX-EDITORIAL-AI v1.0.0 berstatus usulan kerja (PROPOSED) tanpa tanggal berlaku efektif, dan bukan pernyataan status badan hukum pers, verifikasi Dewan Pers, atau pendaftaran Penyelenggara Sistem Elektronik (PSE).",
  "checksumSpecification": {
    "algorithm": "sha256",
    "encoding": "utf-8",
    "lineEndings": "lf",
    "targetField": "bodyMarkdown",
    "recipe": "Normalisasikan pemisah baris CRLF/CR menjadi LF (\\n) pada string bodyMarkdown JSON yang dikembalikan (atau pada tubuh Markdown bebas banner pratinjau HTTP), enkode UTF-8, lalu hitung SHA-256 heksadesimal huruf kecil.",
    "etagNote": "Header ETag untuk JSON dan Markdown mencerminkan identifikasi versi dokumen dan checksum kanonik; klien dapat mengirim ulang nilai tersebut lewat header If-None-Match untuk menerima 304 Not Modified."
  },
  "loadingProtocol": {
    "mode": "selective_by_desk_and_format",
    "alwaysLoad": [
      "core/VERAX_EDITORIAL_IDENTITY.md",
      "core/VERAX_JOURNALISTIC_PRINCIPLES.md",
      "core/VERAX_RESEARCH_AND_VERIFICATION.md",
      "core/VERAX_ETHICS_AND_RESPONSIBILITY.md",
      "core/VERAX_LANGUAGE_AND_STYLE.md"
    ],
    "loadSingleAssignedDeskFrom": "desks[].profileUrl",
    "loadSingleAssignedFormatFrom": "formats[].profileUrl",
    "loadForAiAgentDrafting": [
      "operations/VERAX_AI_AGENT_WORKFLOW.md",
      "operations/VERAX_EDITORIAL_REVIEW_CHECKLIST.md",
      "VERAX_PUBLIC_API_INTEGRATION.md"
    ],
    "loadForQualityReview": [
      "operations/VERAX_EDITORIAL_QUALITY_ASSESSMENT.md",
      "operations/VERAX_EDITORIAL_REVIEW_CHECKLIST.md"
    ],
    "failClosedOnInactiveOrUnknownDesk": true,
    "mustNotCrossLoadUnassignedDesksOrFormats": true
  },
  "conflictResolutionHierarchy": [
    {
      "priority": 1,
      "layer": "Universal Integrity, Ethics, and Non-Fabrication",
      "source": "Core Knowledge Base (/editorial/core) + FAIL-01..FAIL-07"
    },
    {
      "priority": 2,
      "layer": "Assigned Desk Evidentiary and Legal Rules",
      "source": "Single Desk Profile (/editorial/desks/{slug})"
    },
    {
      "priority": 3,
      "layer": "Assigned Format Voice, Structure, and Origin Rules",
      "source": "Single Format Profile (/editorial/formats/{format})"
    },
    {
      "priority": 4,
      "layer": "Specific Assignment Context (Layer D)",
      "source": "AI Agent Workflow (/editorial/operations/ai-workflow)"
    }
  ],
  "normativeKeywords": {
    "MUST": "WAJIB",
    "MUST_NOT": "DILARANG",
    "SHOULD": "DIANJURKAN",
    "MAY": "OPSIONAL"
  },
  "layeredArchitecture": {
    "compositionFormula": "Layer A (Inti Universal) + Layer B (Satu Desk Aktif) + Layer C (Satu Format) + Layer D (Konteks Penugasan)",
    "layerDParameters": [
      "desk",
      "format",
      "topic",
      "mainEditorialQuestion",
      "intendedAudience",
      "proposedAngle",
      "availableSources",
      "currentnessAndChronology",
      "geographicInstitutionalContext",
      "requestedDepth",
      "knownInformationGaps"
    ]
  },
