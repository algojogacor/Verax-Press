  "rubricIndex": {
    "documentId": "VERAX-OPS-QUALITY-02",
    "autoPublishAuthorized": false,
    "highScoreOverridesFailure": false,
    "nonNegotiableFailures": [
      { "code": "FAIL-01", "name": "Sumber atau URL Rekaan", "defaultAction": "REJECT_OR_HOLD_REVISION" },
      { "code": "FAIL-02", "name": "Kutipan, Wawancara, atau Adegan Rekaan", "defaultAction": "REJECT" },
      { "code": "FAIL-03", "name": "Kekeliruan Fakta Material", "defaultAction": "REVISION_NEEDED_OR_REJECT" },
      { "code": "FAIL-04", "name": "Tuduhan Serius Tanpa Pembuktian dan Hak Tanggapan", "defaultAction": "HOLD_REVISION_OR_FACT_CHECK" },
      { "code": "FAIL-05", "name": "Penyajian Keliru Dokumen Resmi atau Peradilan", "defaultAction": "REVISION_NEEDED_OR_REJECT" },
      { "code": "FAIL-06", "name": "Plagiarisme atau Pelanggaran Hak Cipta", "defaultAction": "REJECT" },
      { "code": "FAIL-07", "name": "Penyamaran Keterlibatan AI atau Catatan Verifikasi Palsu", "defaultAction": "REJECT_OR_MANDATORY_CORRECTION" }
    ],
    "qualityDimensions": [
      { "code": "DIM-01", "name": "Akurasi dan Keterlacakan Sumber", "scaleMin": 1, "scaleMax": 4 },
      { "code": "DIM-02", "name": "Kedalaman dan Kelengkapan Kontekstual", "scaleMin": 1, "scaleMax": 4 },
      { "code": "DIM-03", "name": "Keberimbangan dan Proporsionalitas", "scaleMin": 1, "scaleMax": 4 },
      { "code": "DIM-04", "name": "Struktur dan Koherensi Logika", "scaleMin": 1, "scaleMax": 4 },
      { "code": "DIM-05", "name": "Bahasa, Presisi Istilah, dan Kejelasan", "scaleMin": 1, "scaleMax": 4 },
      { "code": "DIM-06", "name": "Transparansi AI dan Kejujuran Batasan", "scaleMin": 1, "scaleMax": 4 }
    ]
  },
  "systemContractReference": {
    "validContentBlockTypes": ["paragraph", "heading", "quote", "list", "image", "note", "qa"],
    "contentBlockRequirements": {
      "maxBlocks": 300,
      "headingLevels": [2, 3],
      "listRequiredStyles": ["bullet", "number"],
      "firstParagraphDropCapMinChars": 120
    },
    "aiInvolvementEnum": ["none", "assistive", "substantive"],
    "sourceTypes": ["PRIMARY", "SECONDARY", "DOCUMENT", "INTERVIEW", "DATA", "OFFICIAL"],
    "endpoints": {
      "capabilities": "GET /api/internal/v1/capabilities",
      "validate": "POST /api/internal/v1/ai-submissions/validate",
      "submit": "POST /api/internal/v1/ai-submissions",
      "status": "GET /api/internal/v1/ai-submissions/{submissionId}"
    },
    "initialArticleStatus": "DRAFT",
    "initialSubmissionStatus": "SUBMITTED",
    "initialSourceVerificationStatus": "UNVERIFIED",
    "deckRequiredForPublish": true,
    "humanBylineRequiredForPublish": true,
    "publishGates": [
      "GATE_NO_KEY_SOURCES",
      "GATE_SOURCE_VERIFICATION",
      "GATE_EMPTY_CONTENT",
      "GATE_NO_DECK",
      "GATE_AI_DISCLOSURE",
      "GATE_BYLINE_UNCONFIRMED"
    ]
  },
  "exposureTargets": [
    "/api/internal/v1/capabilities",
    "/.well-known/verax-agent.json",
    "/openapi.json",
    "/llms.txt",
    "/llms-full.txt",
    "/developers"
  ],
  "revisionHistory": [
    {
      "version": "1.0.0",
